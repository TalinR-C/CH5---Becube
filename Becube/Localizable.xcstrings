    "practice.urge_surfing.observe.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where do you feel this in your body right now? There's no wrong answer, just notice."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di mana kamu merasakannya di tubuhmu sekarang? Tidak ada jawaban yang salah, cukup perhatikan saja."
          }
        }
      }
    },
    "practice.urge_surfing.observe.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notice Without Judging"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhatikan Tanpa Menghakimi"
          }
        }
      }
    },
    "practice.urge_surfing.surf.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picture the urge as a wave. Follow your breath as it rises and falls. Let it come, and let it go."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayangkan dorongan ini sebagai ombak. Ikuti napasmu saat ombak itu naik dan turun. Biarkan ia datang, dan biarkan ia pergi."
          }
        }
      }
    },
    "practice.urge_surfing.surf.reminder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This urge isn't permanent. You've ridden out hard moments before. Tap Done below whenever you're ready."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorongan ini tidak akan berlangsung selamanya. Kamu pernah melewati momen-momen sulit sebelumnya. Ketuk Selesai di bawah kapan pun kamu siap."
          }
        }
      }
    },
