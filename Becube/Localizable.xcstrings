    "practice.urge_surfing.name.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say what you're feeling the urge to do. Naming it gives you a little space to respond instead of react."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucapkan apa yang kamu rasakan ingin lakukan. Menamainya memberimu sedikit ruang untuk merespons, bukan bereaksi."
          }
        }
      }
    },
