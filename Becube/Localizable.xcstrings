    },
    "practice.urge_surfing.surf.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picture the urge as a wave. Follow your breath as it rises and falls. Let it come, and let it go."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayangkan dorongan ini sebagai ombak. Ikuti napasmu saat ombak itu naik dan turun. Biarkan ia datang, dan biarkan ia pergi."
          }
        }
      }
    },
    "practice.urge_surfing.surf.reminder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This urge isn't permanent. You've ridden out hard moments before. Tap Done below whenever you're ready."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorongan ini tidak akan berlangsung selamanya. Kamu pernah melewati momen-momen sulit sebelumnya. Ketuk Selesai di bawah kapan pun kamu siap."
          }
        }
      }
    },
