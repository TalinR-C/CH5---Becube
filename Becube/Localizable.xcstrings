    "Take a step back" : {
      "comment" : "A heading for the step where you take a step back.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambil jarak sejenak"
          }
        }
      }
    },
    "Tap for each one you notice" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk untuk setiap hal yang kamu sadari"
          }
        }
      }
    },
    "Tap the plant to revisit what you've learned" : {
      "comment" : "A text bubble that appears on the shelf's first load.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk tanaman untuk meninjau kembali apa yang telah kamu pelajari"
          }
        }
      }
    },
    "Tap when\nyou've done it" : {
      "comment" : "A label displayed in a button.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk setelah\nkamu selesai"
          }
        }
      }
    },
    "Tense" : {
      "comment" : "A label for the muscle-tense phase of the TIPP.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegangkan"
          }
        }
      }
    },
    "TENSE" : {
      "comment" : "Label on a timer during the tensing phase of a muscle-relaxation exercise.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TEGANG"
          }
        }
      }
    },
    "Tense one muscle group hard, then let it go." : {
      "comment" : "Detail text for the \"muscle\" step in the TIPP exercise.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegangkan satu kelompok otot kuat-kuat, lalu lepaskan."
          }
        }
      }
    },
    "That's plenty to choose from." : {
      "comment" : "A footnote displayed in the problem-solving view when the list is full.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itu sudah cukup banyak untuk dipilih."
          }
        }
      }
    },
    "The breath moving underneath. Just watch it." : {
      "comment" : "Prompt for the chest region of the body scan.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napas yang bergerak di baliknya. Cukup amati saja."
          }
        }
      }
    },
    "The floor under you, fabric on your skin, the air." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lantai di bawahmu, kain yang menyentuh kulitmu, udara di sekitarmu."
          }
        }
      }
    },
    "The more you learn, the more the garden grows" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semakin banyak kamu belajar, semakin subur tamanmu"
          }
        }
      }
    },
    "The situation is the same. Check whether the fighting is." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situasinya masih sama. Periksa apakah perlawananmu juga masih sama."
          }
        }
      }
    },
    "The smallest one you could actually finish. Not the most worthwhile one." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang paling kecil dan benar-benar bisa kamu selesaikan. Bukan yang paling berarti."
          }
        }
      }
    },
    "then I will" : {
      "comment" : "Prefix before a planned response, as in \"If [situation], then I will [response].\"",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "maka aku akan"
          }
        }
      }
    },
    "Then it's doing its job" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berarti emosi ini sedang menjalankan tugasnya"
          }
        }
      }
    },
    "there's a real threat to your safety or health right now" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ada ancaman nyata terhadap keselamatan atau kesehatanmu saat ini"
          }
        }
      }
    },
    "Thighs" : {
      "comment" : "A muscle group in Progressive Muscle Relaxation.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paha"
          }
        }
      }
    },
    "Things that used to bring some satisfaction, even if they don't sound appealing today." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal-hal yang dulu memberi rasa puas, meski hari ini terdengar kurang menarik."
          }
        }
      }
    },
    "This one isn't a malfunction — it's information." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini bukan kesalahan — ini adalah informasi."
          }
        }
      }
    },
    "This part happens later." : {
      "comment" : "A label displayed above the \"Check how it went\" step.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagian ini terjadi nanti."
          }
        }
      }
    },
    "This practice isn't built yet." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latihan ini belum tersedia."
          }
        }
      }
    },
    "This urge isn't permanent. You've ridden out hard moments before. Tap Done below whenever you're ready." : {
      "comment" : "A message that appears when the user is done surfing.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorongan ini tidak akan berlangsung selamanya. Kamu pernah melewati momen-momen sulit sebelumnya. Ketuk Selesai di bawah kapan pun kamu siap."
          }
        }
      }
    },
    "Three slow breaths to finish." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiga tarikan napas perlahan untuk mengakhiri."
          }
        }
      }
    },
    "Tired" : {
      "comment" : "One of the four needs in the HALT check-in.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lelah"
          }
        }
      }
    },
    "Toes, soles, heels. Warmth, pressure, or nothing at all." : {
      "comment" : "Prompt for noticing the user's feet during a body scan.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jari kaki, telapak kaki, tumit. Kehangatan, tekanan, atau tidak ada apa-apa sama sekali."
          }
        }
      }
    },
    "Traffic, a fan, your own breathing." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara lalu lintas, kipas angin, napasmu sendiri."
          }
        }
      }
    },
    "Twice, if you can. Repeating it is what makes the situation bring the plan to mind." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dua kali, jika bisa. Mengulanginya membuat situasi itu memicu rencana ini untuk teringat."
          }
        }
      }
    },
    "Weigh each one" : {
      "comment" : "A heading for the step of the problem-solving process where the user weighs the pros and cons of each option.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbang masing-masing"
          }
        }
      }
    },
    "What are you feeling?" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang kamu rasakan?"
          }
        }
      }
    },
    "What both columns together actually support." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang benar-benar didukung oleh kedua kolom itu bersama-sama."
          }
        }
      }
    },
    "What can't you change?" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang tidak bisa kamu ubah?"
          }
        }
      }
    },
    "What do you notice in your body?" : {
      "comment" : "A prompt for the user to observe.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang kamu rasakan di tubuhmu?"
          }
        }
      }
    },
    "What emotion is here?" : {
      "comment" : "A prompt for the user to identify an emotion.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emosi apa yang muncul?"
          }
        }
      }
    },
    "What is good about it?" : {
      "comment" : "A placeholder for a text field that asks for the",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa kelebihannya?"
          }
        }
      }
    },
    "What is the cost?" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa risikonya?"
          }
        }
      }
    },
    "What is the urge telling you to do?" : {
      "comment" : "A prompt for the user to identify the urge.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang dorongan ini minta kamu lakukan?"
          }
        }
      }
    },
    "What used to feel good?" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang dulu terasa menyenangkan?"
          }
        }
      }
    },
    "What's The Rating?" : {
      "comment" : "A title for the average rating of a plant.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa Arti Penilaian Ini?"
          }
        }
      }
    },
    "Whatever's already in your mouth. Or take a sip." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa pun yang sudah ada di mulutmu. Atau minumlah seteguk."
          }
        }
      }
    },
    "Whatever's weighing on you. Grammar doesn't matter, and neither does whether it makes sense." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa pun yang membebani pikiranmu. Tata bahasa tidak penting, begitu juga apakah itu masuk akal."
          }
        }
      }
    },
    "When did you last eat something proper?" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapan terakhir kali kamu makan dengan layak?"
          }
        }
      }
    },
    "Where you're being held up. Let it be heavy." : {
      "comment" : "Description of a body region prompt for the hips.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagian yang menahan bebanmu. Biarkan terasa berat."
          }
        }
      }
    },
    "With everything" : {
      "comment" : "The high end of an intensity scale — resisting as much as possible.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habis-habisan"
          }
        }
      }
    },
    "withdraw" : {
      "comment" : "The short verb form of an urge, in Opposite Action.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "menarik diri"
          }
        }
      }
    },
    "Withdraw. Shut down. Do nothing." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menarik diri. Menutup diri. Tidak melakukan apa-apa."
          }
        }
      }
    },
    "Write down 2–3 things for each sense that would help you feel calmer." : {
      "comment" : "A description of the Self-Soothing worksheet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuliskan 2–3 hal untuk setiap indra yang dapat membantumu merasa lebih tenang."
          }
        }
      }
    },
    "Write it exactly as it arrived — unedited, unsoftened." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis persis seperti saat pikiran itu muncul — tanpa diedit, tanpa diperhalus."
          }
        }
      }
    },
    "Write the balanced version" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis versi yang seimbang"
          }
        }
      }
    },
    "Write what you notice." : {
      "comment" : "A label that describes a textbox for a reflection.",
