    "shelf.tutorial_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the plant to revisit what you've learned"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk tanaman untuk meninjau kembali apa yang telah kamu pelajari"
          }
        }
      }
    },
    "skill.behavioral_activation.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. List a few activities that used to bring you satisfaction or pleasure.\n2. Pick one small enough to actually do today.\n3. Put it on your calendar like an appointment.\n4. Notice your mood afterward, even if you didn't feel like starting."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Buat daftar beberapa aktivitas yang dulu memberimu kepuasan atau kesenangan.\n2. Pilih satu yang cukup kecil untuk benar-benar bisa kamu lakukan hari ini.\n3. Masukkan ke dalam jadwalmu seperti sebuah janji temu.\n4. Perhatikan suasana hatimu setelahnya, meskipun kamu tidak merasa ingin memulainya."
          }
        }
      }
    },
    "skill.behavioral_activation.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deliberately scheduling small, meaningful, or enjoyable activities, rather than waiting to feel motivated first."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan sengaja menjadwalkan aktivitas kecil, bermakna, atau menyenangkan, alih-alih menunggu merasa termotivasi terlebih dahulu."
          }
        }
      }
    },
    "skill.behavioral_activation.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low motivation, low mood, or the pull to withdraw and do nothing."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat motivasi rendah, suasana hati buruk, atau dorongan untuk menarik diri dan tidak melakukan apa-apa."
          }
        }
      }
    },
    "skill.behavioral_activation.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Research consistently shows that action often has to come before motivation, not after. Increasing engagement in rewarding activities reliably lifts mood, even without changing your thoughts first."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penelitian secara konsisten menunjukkan bahwa tindakan sering kali harus muncul sebelum motivasi, bukan sesudahnya. Meningkatkan keterlibatan dalam aktivitas yang menyenangkan secara andal dapat memperbaiki suasana hati, bahkan tanpa mengubah pikiranmu terlebih dahulu."
          }
        }
      }
    },
    "skill.behavioral_activation.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behavioral Activation"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivasi Perilaku"
          }
        }
      }
    },
    "skill.behavioral_activation.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butterfly Bush"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buddleia"
          }
        }
      }
    },
    "skill.behavioral_activation.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butterfly bush doesn't wait for pollinators to arrive — it puts out fragrant blooms deliberately, drawing life to it before anything shows up on its own."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buddleia tidak menunggu penyerbuk datang — ia sengaja mengeluarkan bunga yang harum, menarik kehidupan kepadanya sebelum apa pun muncul dengan sendirinya."
          }
        }
      }
    },
    "skill.body_scan.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lying or sitting comfortably, bring your attention to your feet, then legs, torso, arms, and head — pausing at each, just noticing warmth, tension, or nothing at all."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambil berbaring atau duduk dengan nyaman, arahkan perhatianmu ke kaki, lalu tungkai, badan, lengan, dan kepala — berhenti sejenak di setiap bagian, cukup perhatikan kehangatan, ketegangan, atau tidak ada apa-apa sama sekali."
          }
        }
      }
    },
    "skill.body_scan.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowly moving your attention through each part of your body, noticing sensations without trying to change them."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlahan menggerakkan perhatianmu melalui setiap bagian tubuh, memperhatikan sensasi yang muncul tanpa mencoba mengubahnya."
          }
        }
      }
    },
    "skill.body_scan.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To unwind before sleep, or to reconnect with your body when you've been \"in your head\" for too long."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk bersantai sebelum tidur, atau untuk terhubung kembali dengan tubuhmu ketika kamu terlalu lama “terjebak dalam pikiran”."
          }
        }
      }
    },
    "skill.body_scan.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Developed by Jon Kabat-Zinn as part of Mindfulness-Based Stress Reduction, this practice interrupts the loop between racing thoughts and physical tension by anchoring attention in the body instead."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikembangkan oleh Jon Kabat-Zinn sebagai bagian dari Mindfulness-Based Stress Reduction, latihan ini memutus siklus antara pikiran yang berpacu dan ketegangan fisik dengan menambatkan perhatian pada tubuh."
          }
        }
      }
    },
    "skill.body_scan.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body Scan"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemindaian Tubuh"
          }
        }
      }
    },
    "skill.body_scan.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yellow Hydrangea"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hortensia Kuning"
          }
        }
      }
    },
    "skill.body_scan.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hydrangea bloom is actually dozens of small florets bunched together — from a distance it looks like one flower, but each one only opens when you look closely enough to notice it individually."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga hortensia sebenarnya terdiri dari puluhan kuntum kecil yang berkumpul menjadi satu — dari kejauhan terlihat seperti satu bunga, tetapi masing-masing hanya mekar saat kamu melihat cukup dekat untuk memperhatikannya satu per satu."
          }
        }
      }
    },
    "skill.box_breathing.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Breathe in through your nose for 4 seconds.\n2. Hold for 4 seconds.\n3. Breathe out through your mouth for 4 seconds.\n4. Hold for 4 seconds.\nRepeat for a few rounds."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tarik napas melalui hidung selama 4 detik.\n2. Tahan selama 4 detik.\n3. Embuskan napas melalui mulut selama 4 detik.\n4. Tahan selama 4 detik.\nUlangi selama beberapa putaran."
          }
        }
      }
    },
    "skill.box_breathing.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A slow, structured breathing pattern — inhale, hold, exhale, hold, each for the same count — that resets your breathing rate after stress."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pola pernapasan yang lambat dan terstruktur — tarik napas, tahan, embuskan, tahan, masing-masing dengan hitungan yang sama — yang mengatur ulang laju napasmu setelah mengalami stres."
          }
        }
      }
    },
    "skill.box_breathing.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before a stressful conversation, when your heart is racing, or any moment you need to feel steady fast."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum percakapan yang membuat stres, saat jantungmu berdebar kencang, atau saat mana pun kamu perlu merasa tenang dengan cepat."
          }
        }
      }
    },
    "skill.box_breathing.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowing your breath to about 4–6 breaths a minute calms your nervous system and lowers stress hormones like cortisol. It won't erase what's stressing you, but it can bring your body back to a place where you can think clearly."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memperlambat napas menjadi sekitar 4–6 kali per menit menenangkan sistem sarafmu dan menurunkan hormon stres seperti kortisol. Ini tidak akan menghilangkan hal yang membuatmu stres, tetapi dapat membawa tubuhmu kembali ke kondisi di mana kamu bisa berpikir jernih."
          }
        }
      }
    },
    "skill.box_breathing.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Box Breathing"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pernapasan Kotak"
          }
        }
      }
    },
    "skill.box_breathing.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickerel Rush"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickerel Rush"
          }
        }
      }
    },
    "skill.box_breathing.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickerel rush grows in even, upright stalks along the shoreline, holding its shape through rising and falling water — structure that doesn't waver with what's around it."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickerel rush tumbuh dalam batang yang tegak dan merata di sepanjang tepi air, mempertahankan bentuknya saat air pasang dan surut — struktur yang tidak goyah oleh apa pun di sekitarnya."
          }
        }
      }
    },
    "skill.cognitive_reframing.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Write the thought down exactly as it came (\"I always mess everything up\").\n2. Ask: what's the evidence for and against it?\n3. Write a more balanced version (\"I made a mistake this time, not every time\")."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Tuliskan pikiran itu persis seperti saat muncul (“Aku selalu mengacaukan semuanya”).\n2. Tanyakan: apa bukti yang mendukung dan menentangnya?\n3. Tuliskan versi yang lebih seimbang (“Aku membuat kesalahan kali ini, bukan setiap saat”)."
          }
        }
      }
    },
    "skill.cognitive_reframing.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catching an automatic negative thought and asking whether it's actually accurate, then finding a more balanced way to see it."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menangkap pikiran negatif otomatis dan bertanya apakah pikiran itu benar-benar akurat, lalu menemukan cara pandang yang lebih seimbang."
          }
        }
      }
    },
    "skill.cognitive_reframing.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When one thought spirals into a much bigger story about yourself than the facts actually support."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketika satu pikiran berkembang menjadi cerita yang jauh lebih besar tentang dirimu daripada yang sebenarnya didukung oleh fakta."
          }
        }
      }
    },
    "skill.cognitive_reframing.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aaron Beck's cognitive model shows that it's our interpretation of events — not the events themselves — that drives how we feel. Changing the thought can change the feeling."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model kognitif Aaron Beck menunjukkan bahwa interpretasi kita terhadap suatu peristiwa — bukan peristiwanya itu sendiri — yang menentukan bagaimana perasaan kita. Mengubah pikiran dapat mengubah perasaan."
          }
        }
      }
    },
    "skill.cognitive_reframing.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cognitive Reframing (Thought Record)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembingkaian Ulang Kognitif (Catatan Pikiran)"
          }
        }
      }
    },
    "skill.cognitive_reframing.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blue Butterfly Bush"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buddleia Biru"
          }
        }
      }
    },
    "skill.cognitive_reframing.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From a distance a butterfly bush cone looks like one solid color, but each tiny floret is doing its own thing up close — the same bloom looks entirely different depending on how you choose to view it."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dari kejauhan, kerucut bunga buddleia terlihat seperti satu warna solid, tetapi setiap kuntum kecilnya melakukan hal yang berbeda saat dilihat dari dekat — bunga yang sama bisa terlihat sangat berbeda tergantung bagaimana kamu memilih untuk memandangnya."
          }
        }
      }
    },
    "skill.expressive_writing.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a timer for 15–20 minutes. Write continuously about what's weighing on you, without worrying about grammar or whether it makes sense. Don't reread it right away."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur pengatur waktu selama 15–20 menit. Tulis terus-menerus tentang apa yang membebani pikiranmu, tanpa khawatir soal tata bahasa atau apakah tulisannya masuk akal. Jangan langsung membacanya kembali."
          }
        }
      }
    },
    "skill.expressive_writing.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writing honestly about a difficult experience — the facts, the emotions, and the thoughts — for a set period of time."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menulis dengan jujur tentang pengalaman yang sulit — fakta, emosi, dan pikiran — selama jangka waktu tertentu."
          }
        }
      }
    },
    "skill.expressive_writing.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When something is sitting unprocessed — replaying in your mind but never actually said out loud, even to yourself."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketika ada sesuatu yang belum terselesaikan — terus terputar dalam pikiranmu tetapi tidak pernah benar-benar diucapkan, bahkan pada dirimu sendiri."
          }
        }
      }
    },
    "skill.expressive_writing.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "James Pennebaker's research found that writing about emotional experiences, even briefly over just a few days, can improve both mood and physical health outcomes over time.\n\nCaution: writing about something painful can feel more intense before it feels better. Stop if it becomes overwhelming, and talk to someone you trust."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penelitian James Pennebaker menemukan bahwa menulis tentang pengalaman emosional, bahkan secara singkat selama beberapa hari saja, dapat memperbaiki suasana hati dan kondisi kesehatan fisik seiring waktu.\n\nPeringatan: menulis tentang sesuatu yang menyakitkan bisa terasa lebih intens sebelum akhirnya membaik. Berhenti jika terasa terlalu berat, dan bicaralah dengan seseorang yang kamu percaya."
          }
        }
      }
    },
    "skill.expressive_writing.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expressive Writing"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menulis Ekspresif"
          }
        }
      }
    },
    "skill.expressive_writing.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yellow Daisy"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga Aster Kuning"
          }
        }
      }
    },
    "skill.expressive_writing.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulling petals from a daisy one at a time, saying something out loud with every one, turns a tangled feeling into something you can count and put down."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencabut kelopak bunga aster satu per satu, sambil mengucapkan sesuatu dengan lantang setiap kalinya, mengubah perasaan yang kusut menjadi sesuatu yang bisa kamu hitung dan letakkan."
          }
        }
      }
    },
    "skill.grounding.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name, out loud or silently:\n5 things you can see.\n4 things you can feel.\n3 things you can hear.\n2 things you can smell.\n1 thing you can taste.\nGo slowly. Repeat if you still feel far away."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebutkan, dengan suara keras atau dalam hati:\n5 hal yang bisa kamu lihat.\n4 hal yang bisa kamu rasakan.\n3 hal yang bisa kamu dengar.\n2 hal yang bisa kamu cium.\n1 hal yang bisa kamu kecap.\nLakukan perlahan. Ulangi jika kamu masih merasa jauh."
          }
        }
      }
    },
    "skill.grounding.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using your five senses to pull your attention out of your head and back into the room around you."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan kelima inderamu untuk menarik perhatianmu keluar dari pikiran dan kembali ke ruang di sekitarmu."
          }
        }
      }
    },
    "skill.grounding.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panic, feeling unreal or detached, or when a craving is pulling your focus inward."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat panik, merasa tidak nyata atau terlepas, atau ketika keinginan kuat menarik fokusmu ke dalam diri."
          }
        }
      }
    },
    "skill.grounding.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention is limited — filling it with real, present things leaves less room for the spiral inside. This exact sequence hasn't been tested in isolation, but grounding is used across DBT, CBT, and trauma-informed care as a front-line tool for calming an overactive stress response."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhatian itu terbatas — mengisinya dengan hal-hal nyata yang ada saat ini menyisakan lebih sedikit ruang untuk pusaran pikiran di dalam. Urutan yang persis ini belum diuji secara terpisah, tetapi grounding digunakan di seluruh DBT, CBT, dan perawatan yang peka trauma sebagai alat lini pertama untuk menenangkan respons stres yang berlebihan."
          }
        }
      }
    },
    "skill.grounding.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grounding (5-4-3-2-1)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grounding (5-4-3-2-1)"
          }
        }
      }
    },
    "skill.grounding.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purple Canna Lilies"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga Tasbih Ungu"
          }
        }
      }
    },
    "skill.grounding.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canna's rhizomes anchor thick and deep underground, keeping the whole plant steady no matter what's happening in the leaves above."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rizoma bunga tasbih tertanam tebal dan dalam di bawah tanah, menjaga seluruh tanaman tetap stabil apa pun yang terjadi pada daun-daun di atasnya."
          }
        }
      }
    },
    "skill.halt_check_in.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause and ask yourself: Am I hungry? Angry? Lonely? Tired? Whichever answer is \"yes,\" address that one first, before deciding anything else."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berhenti sejenak dan tanyakan pada dirimu: Apakah aku lapar? Marah? Kesepian? Lelah? Mana pun jawabannya “ya”, atasi itu dulu, sebelum memutuskan hal lain."
          }
        }
      }
    },
    "skill.halt_check_in.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quick check-in on four basic needs that quietly make everything harder when they're unmet: Hungry, Angry, Lonely, Tired."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemeriksaan singkat terhadap empat kebutuhan dasar yang diam-diam membuat segalanya lebih sulit jika tidak terpenuhi: Lapar, Marah, Kesepian, Lelah."
          }
        }
      }
    },
    "skill.halt_check_in.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anytime you notice you're irritable, foggy, or suddenly craving — often the real problem is one of these four, not what you think it is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapan pun kamu menyadari dirimu mudah tersinggung, sulit berpikir jernih, atau tiba-tiba menginginkan sesuatu — seringkali masalah sebenarnya adalah salah satu dari empat hal ini, bukan yang kamu kira."
          }
        }
      }
    },
    "skill.halt_check_in.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long used in addiction recovery communities, HALT works because these four states quietly lower your ability to cope, making relapse and poor decisions more likely if left unaddressed."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telah lama digunakan dalam komunitas pemulihan kecanduan, HALT berhasil karena keempat kondisi ini diam-diam menurunkan kemampuanmu untuk mengatasi masalah, membuat kekambuhan dan keputusan buruk lebih mungkin terjadi jika dibiarkan."
          }
        }
      }
    },
    "skill.halt_check_in.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALT Check-In"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemeriksaan HALT"
          }
        }
      }
    },
    "skill.halt_check_in.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunflower"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga Matahari"
          }
        }
      }
    },
    "skill.halt_check_in.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sunflower wilts fast the moment it's short on water, sun, or food — an unmistakable, immediate signal that a basic need is going unmet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga matahari cepat layu begitu kekurangan air, sinar matahari, atau nutrisi — sinyal yang jelas dan langsung bahwa kebutuhan dasarnya tidak terpenuhi."
          }
        }
      }
    },
    "skill.if_then_planning.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Placeholder step 1.\n2. Placeholder step 2.\n3. Placeholder step 3."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Langkah sementara 1.\n2. Langkah sementara 2.\n3. Langkah sementara 3."
          }
        }
      }
    },
    "skill.if_then_planning.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placeholder description for what If–Then Planning is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deskripsi sementara untuk penjelasan apa itu Perencanaan Jika–Maka."
          }
        }
      }
    },
    "skill.if_then_planning.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placeholder description for when to use this skill."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deskripsi sementara untuk kapan menggunakan keterampilan ini."
          }
        }
      }
    },
    "skill.if_then_planning.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placeholder description for why this skill works."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deskripsi sementara untuk mengapa keterampilan ini berhasil."
          }
        }
      }
    },
    "skill.if_then_planning.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If–Then Planning"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perencanaan Jika–Maka"
          }
        }
      }
    },
    "skill.if_then_planning.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daisy"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga Aster"
          }
        }
      }
    },
    "skill.if_then_planning.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A daisy doesn't decide each morning whether to open — it follows one simple rule, opening at first light and closing at dusk, every time, without having to choose it fresh."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga aster tidak memutuskan setiap pagi apakah akan mekar — ia mengikuti satu aturan sederhana, mekar saat fajar dan menutup saat senja, setiap saat, tanpa harus memilihnya kembali."
          }
        }
      }
    },
    "skill.opposite_action.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Name the emotion and its urge (fear says hide; anger says lash out).\n2. Ask: does this emotion actually fit the facts right now?\n3. If not, do the opposite — fully, not half-heartedly. Approach instead of avoid; speak gently instead of snapping."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Beri nama emosi dan dorongannya (rasa takut berkata sembunyi; kemarahan berkata melampiaskan).\n2. Tanyakan: apakah emosi ini benar-benar sesuai dengan fakta saat ini?\n3. Jika tidak, lakukan sebaliknya — sepenuhnya, bukan setengah hati. Mendekat, bukan menghindar; bicara dengan lembut, bukan membentak."
          }
        }
      }
    },
    "skill.opposite_action.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deliberately acting the opposite of what a difficult emotion is urging you to do."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan sengaja bertindak berlawanan dengan apa yang didorong oleh emosi yang sulit."
          }
        }
      }
    },
    "skill.opposite_action.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When an emotion is real but not helpful — like avoiding a friend out of shame, when reaching out is what would actually help."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketika emosi itu nyata tetapi tidak membantu — seperti menghindari teman karena rasa malu, padahal menghubunginya adalah yang sebenarnya akan membantu."
          }
        }
      }
    },
    "skill.opposite_action.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotions and actions reinforce each other. Repeatedly acting opposite to an unhelpful urge, with full effort, weakens that emotion's grip over time."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emosi dan tindakan saling memperkuat satu sama lain. Berulang kali bertindak berlawanan dengan dorongan yang tidak membantu, dengan usaha penuh, melemahkan cengkeraman emosi itu seiring waktu."
          }
        }
      }
    },
    "skill.opposite_action.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opposite Action"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan Berlawanan"
          }
        }
      }
    },
    "skill.opposite_action.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purple Delphinium"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delphinium Ungu"
          }
        }
      }
    },
    "skill.opposite_action.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delphinium spikes grow straight up against gravity's pull, never leaning toward the path of least resistance — a stance chosen on purpose, not the one automatic to take."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tangkai bunga delphinium tumbuh lurus melawan tarikan gravitasi, tidak pernah condong ke arah yang paling mudah — sikap yang dipilih dengan sengaja, bukan yang otomatis diambil."
          }
        }
      }
    },
    "skill.problem_solving_steps.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Define the problem in one clear sentence.\n2. List every possible solution, even bad ones.\n3. Weigh the pros and cons of each.\n4. Pick one and try it.\n5. Check how it went, and adjust."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Rumuskan masalah dalam satu kalimat yang jelas.\n2. Daftar semua kemungkinan solusi, bahkan yang buruk sekalipun.\n3. Timbang kelebihan dan kekurangan masing-masing.\n4. Pilih satu dan coba.\n5. Periksa bagaimana hasilnya, dan sesuaikan."
          }
        }
      }
    },
    "skill.problem_solving_steps.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A structured way to work through a real problem instead of getting stuck circling it."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara terstruktur untuk menyelesaikan masalah nyata, alih-alih terjebak berputar-putar di sekitarnya."
          }
        }
      }
    },
    "skill.problem_solving_steps.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A real, solvable problem is sitting in front of you, but it feels too big or tangled to start."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada masalah nyata yang bisa dipecahkan di depanmu, tetapi terasa terlalu besar atau rumit untuk dimulai."
          }
        }
      }
    },
    "skill.problem_solving_steps.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People who feel overwhelmed by daily problems are more likely to struggle with stress and low mood. Problem-Solving Therapy shows that a structured, step-by-step approach meaningfully improves how well people cope."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang merasa kewalahan oleh masalah sehari-hari lebih rentan mengalami stres dan suasana hati yang buruk. Terapi Pemecahan Masalah menunjukkan bahwa pendekatan terstruktur langkah demi langkah secara signifikan memperbaiki kemampuan seseorang untuk mengatasi masalah."
          }
        }
      }
    },
    "skill.problem_solving_steps.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problem-Solving Steps"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah-langkah Pemecahan Masalah"
          }
        }
      }
    },
    "skill.problem_solving_steps.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delphinium"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delphinium"
          }
        }
      }
    },
    "skill.problem_solving_steps.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delphinium blooms climb the stalk in order, one floret opening only after the one below it has — a flower that unfolds in a set sequence, not all at once."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga delphinium mekar secara berurutan di sepanjang tangkainya, satu kuntum mekar hanya setelah kuntum di bawahnya mekar — bunga yang mekar dalam urutan tertentu, bukan sekaligus."
          }
        }
      }
    },
    "skill.progressive_muscle_relaxation.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Starting with your feet, tense the muscles hard for 5 seconds.\n2. Release suddenly and notice the difference.\n3. Move upward — calves, thighs, stomach, hands, arms, shoulders, face.\n4. Finish with a few slow breaths."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Mulai dari kakimu, tegangkan otot dengan kuat selama 5 detik.\n2. Lepaskan secara tiba-tiba dan perhatikan perbedaannya.\n3. Lanjutkan ke atas — betis, paha, perut, tangan, lengan, bahu, wajah.\n4. Akhiri dengan beberapa tarikan napas perlahan."
          }
        }
      }
    },
    "skill.progressive_muscle_relaxation.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deliberately tensing and then releasing muscle groups, one at a time, so your body learns the difference between tension and relaxation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan sengaja menegangkan lalu melepaskan kelompok otot, satu per satu, sehingga tubuhmu belajar membedakan antara ketegangan dan relaksasi."
          }
        }
      }
    },
    "skill.progressive_muscle_relaxation.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before sleep, after a tense day, or whenever your body feels wound up even if your mind can't say why."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum tidur, setelah hari yang penuh ketegangan, atau kapan pun tubuhmu terasa tegang meskipun pikiranmu tidak bisa menjelaskan alasannya."
          }
        }
      }
    },
    "skill.progressive_muscle_relaxation.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Physician Edmund Jacobson found that patients who could consciously relax their muscles recovered from stress faster. Tensing first makes the release that follows more noticeable and complete.\n\nCaution: skip tensing any muscle that's currently injured or in pain."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokter Edmund Jacobson menemukan bahwa pasien yang bisa merilekskan otot mereka secara sadar pulih dari stres lebih cepat. Menegangkan otot terlebih dahulu membuat pelepasan yang mengikutinya terasa lebih jelas dan menyeluruh.\n\nPeringatan: lewati penegangan pada otot mana pun yang sedang cedera atau terasa sakit."
          }
        }
      }
    },
    "skill.progressive_muscle_relaxation.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progressive Muscle Relaxation"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaksasi Otot Progresif"
          }
        }
      }
    },
    "skill.progressive_muscle_relaxation.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pink Marsh Marigold"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marigold Rawa Merah Muda"
          }
        }
      }
    },
    "skill.progressive_muscle_relaxation.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marsh marigold petals close in tight through the cold, then open fully again once it's warm — the same rhythm of contracting and releasing this skill trains in muscle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelopak marigold rawa menutup rapat saat cuaca dingin, lalu terbuka penuh kembali saat hangat — ritme mengencang dan melepas yang sama seperti yang dilatih keterampilan ini pada otot."
          }
        }
      }
    },
    "skill.radical_acceptance.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Notice you're fighting reality (\"this shouldn't be happening\").\n2. Remind yourself: it is happening.\n3. Say to yourself, \"I don't have to like this. I just don't have to fight it right now.\"\n4. Notice if the fighting itself eases, even if the situation doesn't."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Perhatikan saat kamu melawan kenyataan (“ini seharusnya tidak terjadi”).\n2. Ingatkan dirimu: ini memang terjadi.\n3. Katakan pada dirimu, “Aku tidak harus menyukai ini. Aku hanya tidak perlu melawannya sekarang.”\n4. Perhatikan apakah perlawanan itu sendiri mereda, meskipun situasinya tidak berubah."
          }
        }
      }
    },
    "skill.radical_acceptance.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fully accepting a painful reality as it is, right now — not approving of it, just no longer fighting the fact that it's true."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menerima sepenuhnya kenyataan yang menyakitkan apa adanya, saat ini juga — bukan menyetujuinya, hanya berhenti melawan fakta bahwa itu benar."
          }
        }
      }
    },
    "skill.radical_acceptance.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When something can't be changed right now, and the struggle against it is adding pain on top of pain."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketika sesuatu tidak bisa diubah saat ini, dan perjuangan melawannya justru menambah rasa sakit di atas rasa sakit."
          }
        }
      }
    },
    "skill.radical_acceptance.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fighting an unchangeable reality is its own source of suffering. Acceptance doesn't mean giving up — it frees up energy that was previously spent resisting what's already true."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melawan kenyataan yang tidak bisa diubah adalah sumber penderitaan tersendiri. Penerimaan bukan berarti menyerah — ia membebaskan energi yang sebelumnya terpakai untuk menolak sesuatu yang sudah nyata."
          }
        }
      }
    },
    "skill.radical_acceptance.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radical Acceptance"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penerimaan Radikal"
          }
        }
      }
    },
    "skill.radical_acceptance.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Sunflower"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga Matahari Putih"
          }
        }
      }
    },
    "skill.radical_acceptance.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sunflower tracks the sun only while it's young — once it matures, it settles facing one direction for good, no longer straining to chase what's already passed."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga matahari mengikuti arah matahari hanya saat masih muda — setelah dewasa, ia menetap menghadap satu arah untuk seterusnya, tidak lagi berusaha mengejar apa yang sudah berlalu."
          }
        }
      }
    },
    "skill.self_soothing.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose one sense at a time: a soft texture to touch, a calming scent, a warm drink to taste, quiet music to hear, something pleasant to look at. Stay with it for a few minutes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih satu indra pada satu waktu: tekstur lembut untuk disentuh, aroma yang menenangkan, minuman hangat untuk dicicipi, musik tenang untuk didengar, sesuatu yang menyenangkan untuk dilihat. Tetaplah dengan itu selama beberapa menit."
          }
        }
      }
    },
    "skill.self_soothing.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deliberately giving each of your five senses something calming to focus on."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan sengaja memberikan sesuatu yang menenangkan untuk difokuskan pada setiap dari kelima inderamu."
          }
        }
      }
    },
    "skill.self_soothing.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you need comfort, not a solution — a low, heavy, or empty kind of day."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketika kamu butuh kenyamanan, bukan solusi — di hari yang terasa berat, murung, atau hampa."
          }
        }
      }
    },
    "skill.self_soothing.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is one of DBT's distress-tolerance skills, meant to soothe the body directly rather than argue with the feeling."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini adalah salah satu keterampilan toleransi distres dari DBT, yang bertujuan menenangkan tubuh secara langsung, bukan berdebat dengan perasaan itu."
          }
        }
      }
    },
    "skill.self_soothing.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Self-Soothing with the Five Senses"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menenangkan Diri dengan Lima Indra"
          }
        }
      }
    },
    "skill.self_soothing.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yellow Pickerel Rush"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickerel Rush Kuning"
          }
        }
      }
    },
    "skill.self_soothing.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickerel rush is planted at the water's edge mostly for how it moves and sounds in the wind — grown for the sensory experience itself, not for anything it does."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickerel rush ditanam di tepi air terutama karena caranya bergerak dan bersuara tertiup angin — ditanam untuk pengalaman sensorinya sendiri, bukan untuk apa yang dilakukannya."
          }
        }
      }
    },
    "skill.stop_skill.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S – Stop. Don't move.\nT – Take a step back, physically or mentally.\nO – Observe what's happening, inside and around you.\nP – Proceed with what actually helps, not just what feels urgent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S – Stop. Jangan bergerak.\nT – Take a step back, ambil jarak, secara fisik maupun dalam pikiran.\nO – Observe, amati apa yang terjadi, di dalam maupun di sekitarmu.\nP – Proceed, lanjutkan dengan hal yang benar-benar membantu, bukan sekadar yang terasa mendesak."
          }
        }
      }
    },
    "skill.stop_skill.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A deliberate pause you take right before you'd otherwise act on impulse."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeda yang sengaja kamu ambil tepat sebelum kamu bertindak berdasarkan impuls."
          }
        }
      }
    },
    "skill.stop_skill.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The exact moment before an impulsive decision — a text you'll regret, a craving you're about to act on."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tepat sebelum keputusan impulsif — pesan yang akan kamu sesali, atau keinginan kuat yang hendak kamu turuti."
          }
        }
      }
    },
    "skill.stop_skill.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impulsive action, when emotion is high, usually narrows your options down to the first one that comes to mind. A deliberate pause creates space to choose instead of react."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan impulsif, saat emosi sedang tinggi, biasanya mempersempit pilihanmu hanya pada hal pertama yang terlintas di pikiran. Jeda yang disengaja menciptakan ruang untuk memilih, bukan sekadar bereaksi."
          }
        }
      }
    },
    "skill.stop_skill.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STOP Skill"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keterampilan STOP"
          }
        }
      }
    },
    "skill.stop_skill.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marsh Marigold"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marigold Rawa"
          }
        }
      }
    },
    "skill.stop_skill.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marsh marigold roots exactly at the line where water meets land — thriving by staying put at the boundary instead of drifting to either side."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marigold rawa berakar tepat di garis pertemuan antara air dan daratan — tumbuh subur dengan tetap berada di batas itu, bukan hanyut ke salah satu sisi."
          }
        }
      }
    },
    "skill.tipp_skill.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick one:\n1. Hold something cold, or splash cold water on your face.\n2. Do a short burst of intense movement — jumping jacks, sprinting in place.\n3. Breathe out longer than you breathe in.\n4. Tense, then release, one muscle group."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih satu:\n1. Pegang benda dingin, atau percikkan air dingin ke wajahmu.\n2. Lakukan gerakan intens singkat — jumping jack, atau lari di tempat.\n3. Embuskan napas lebih lama daripada saat menariknya.\n4. Tegangkan, lalu lepaskan, satu kelompok otot."
          }
        }
      }
    },
    "skill.tipp_skill.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DBT crisis skill using body-based techniques — Temperature, Intense exercise, Paced breathing, Paired muscle relaxation — to bring down overwhelming emotion fast."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keterampilan krisis DBT yang menggunakan teknik berbasis tubuh — Temperature (suhu), Intense exercise (olahraga intens), Paced breathing (pernapasan berirama), Paired muscle relaxation (relaksasi otot berpasangan) — untuk meredakan emosi yang meluap dengan cepat."
          }
        }
      }
    },
    "skill.tipp_skill.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When emotion is so intense you're at risk of doing something you'll regret, and you need relief in minutes, not hours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketika emosi begitu intens sehingga kamu berisiko melakukan sesuatu yang akan kamu sesali, dan kamu butuh kelegaan dalam hitungan menit, bukan jam."
          }
        }
      }
    },
    "skill.tipp_skill.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These techniques act on your body's physiology directly, which works faster than trying to think your way calm when your nervous system is flooded.\n\nCaution: if you have a heart condition, check with a doctor before using cold-water techniques."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teknik-teknik ini bekerja langsung pada fisiologi tubuhmu, yang bekerja lebih cepat daripada mencoba berpikir untuk menenangkan diri saat sistem sarafmu sedang kewalahan.\n\nPeringatan: jika kamu memiliki kondisi jantung, periksakan ke dokter sebelum menggunakan teknik air dingin."
          }
        }
      }
    },
    "skill.tipp_skill.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIPP Skill"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keterampilan TIPP"
          }
        }
      }
    },
    "skill.tipp_skill.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydrangea"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hortensia"
          }
        }
      }
    },
    "skill.tipp_skill.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydrangeas wilt fast in the heat, but a good soak of cool water brings them back within the hour — a plant built for fast recovery, not sturdiness."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hortensia cepat layu dalam cuaca panas, tetapi disiram air sejuk yang cukup dapat memulihkannya dalam waktu satu jam — tanaman yang dibuat untuk pemulihan cepat, bukan ketahanan."
          }
        }
      }
    },
    "skill.urge_surfing.info.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Notice the urge without judging it.\n2. Name where you feel it in your body.\n3. Stay with the sensation, breathing slowly, as it builds.\n4. Notice it start to ease — urges usually pass within about 15–30 minutes if you don't act on them."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Perhatikan dorongan itu tanpa menghakiminya.\n2. Sebutkan di bagian tubuh mana kamu merasakannya.\n3. Tetaplah bersama sensasi itu, bernapas perlahan, saat dorongan itu membesar.\n4. Perhatikan saat mulai mereda — dorongan biasanya berlalu dalam waktu sekitar 15–30 menit jika tidak kamu turuti."
          }
        }
      }
    },
    "skill.urge_surfing.info.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picturing an urge as a wave that rises, peaks, and eventually falls — instead of a command you have to obey."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membayangkan dorongan sebagai ombak yang naik, mencapai puncak, dan akhirnya turun — bukan sebagai perintah yang harus kamu patuhi."
          }
        }
      }
    },
    "skill.urge_surfing.info.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The moment a craving hits and feels too big to sit with."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat keinginan kuat muncul dan terasa terlalu besar untuk dihadapi."
          }
        }
      }
    },
    "skill.urge_surfing.info.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urges are time-limited, not permanent. Psychologist Alan Marlatt developed this technique for relapse prevention on the finding that riding out a craving — rather than fighting or giving in to it — weakens its hold over time."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorongan bersifat sementara, bukan permanen. Psikolog Alan Marlatt mengembangkan teknik ini untuk pencegahan kekambuhan berdasarkan temuan bahwa menunggu dorongan itu berlalu — alih-alih melawan atau menyerah padanya — melemahkan cengkeramannya seiring waktu."
          }
        }
      }
    },
    "skill.urge_surfing.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urge Surfing"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggangi Dorongan"
          }
        }
      }
    },
    "skill.urge_surfing.plant_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canna Lilies"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga Tasbih"
          }
        }
      }
    },
    "skill.urge_surfing.plant_philosophy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canna leaves are broad enough to catch a downpour whole, holding the water only until it crests, then letting it run off without ever bending."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daun bunga tasbih cukup lebar untuk menampung seluruh curahan hujan, menahan air hanya sampai puncaknya, lalu membiarkannya mengalir turun tanpa pernah membungkuk."
          }
        }
      }
    },
    "tab.explore" : {
