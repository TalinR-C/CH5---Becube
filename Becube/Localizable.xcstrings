    "practice.urge_surfing.observe.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where do you feel this in your body right now? There's no wrong answer, just notice."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di mana kamu merasakannya di tubuhmu sekarang? Tidak ada jawaban yang salah, cukup perhatikan saja."
          }
        }
      }
    },
    "practice.urge_surfing.observe.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notice Without Judging"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhatikan Tanpa Menghakimi"
          }
        }
